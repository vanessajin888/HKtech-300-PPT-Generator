# backend/.env
# 本文件用于存放本地敏感配置（例如 DeepSeek 的 API Key）。
# 注意：不要把这个文件提交到任何远程仓库，也不要在聊天中粘贴这里的真实值。

# DeepSeek API Key（请把等号右边替换成你自己的 key）
DEEPSEEK_API_KEY=sk-4c0d2f6cf1c149669b94b64ee9d0c65f

# 是否启用 DeepSeek 作为 /suggest 的真实 LLM
# - true  ：使用 DeepSeekSuggestionProvider（需要上面的 DEEPSEEK_API_KEY 有效）
# - false ：使用 MockSuggestionProvider（本地演示用）
USE_DEEPSEEK=true

